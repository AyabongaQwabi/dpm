# Supabase — required. The app fetches all data from Supabase, so without these
# the homepage renders only the header/footer with empty/broken content.
# Find these in your Supabase project: Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — required for admin/server-side data access and seed scripts.
# Keep this secret. Never expose it to the client or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Pexels — optional. Used to fetch gallery/stock imagery. Leave blank to disable.
PEXELS_API_KEY=

# Yoco — credit purchases and provider subscription renewals.
# Secret key: Yoco dashboard → Settings → API Keys.
YOCO_SECRET_KEY=
# Webhook secret: returned once when registering the webhook (see README for
# the one-time `curl` setup command). Required to verify incoming webhook
# signatures — without it /api/webhooks/yoco rejects everything.
YOCO_WEBHOOK_SECRET=

# Cron — protects /api/cron/* routes (Vercel Cron sends Authorization: Bearer <secret>)
CRON_SECRET=

# Resend — claim verification and subscription emails
RESEND_API_KEY=
CLAIM_CODE_PEPPER=

# Feature requests — server-only salt for hashing submitter IP addresses.
# Required in Vercel before /feature-requests can accept submissions.
FEATURE_REQUEST_IP_HASH_SALT=

# Google Places — scripts/scrape-businesses.mjs only
GOOGLE_PLACES_API_KEY=

# Google Places — browser-side, powers the location autocomplete on the
# onboarding form (components/provider-dashboard/LocationSearchField.tsx).
# Exposed to the client — MUST be restricted in Google Cloud Console to your
# site's domain(s) via "HTTP referrers" and to the Places API only. Do NOT
# reuse the server-only GOOGLE_PLACES_API_KEY above for this.
NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=

# Admin — comma-separated emails allowed into /admin (claim review, etc).
# Checked against the signed-in Supabase Auth user. No admin DB table.
ADMIN_EMAILS=
